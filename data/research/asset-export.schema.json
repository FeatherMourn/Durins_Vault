{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://durins-vault.local/schema/asset-export/v1",
  "title": "Durin's Vault verified asset metadata export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "game", "asset_path", "asset_kind", "reader", "source"],
  "properties": {
    "schema": { "const": "durins-vault.asset-export/v1" },
    "game": { "const": "return-to-moria" },
    "game_build": { "type": "string", "minLength": 1 },
    "asset_path": { "type": "string", "pattern": "^/Game/" },
    "asset_kind": { "enum": ["blueprint", "datatable", "static-mesh", "material", "texture", "other"] },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "exported_on"],
      "properties": {
        "container": { "type": "string", "minLength": 1 },
        "exported_on": { "type": "string", "minLength": 1 },
        "export_file": { "type": ["string", "null"] }
      }
    },
    "properties": { "type": "object" },
    "rows": { "type": "array", "items": { "type": "object" } },
    "notes": { "type": "string" }
  }
}
